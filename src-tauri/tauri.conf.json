{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veilura",
  "version": "1.0.0",
  "identifier": "com.veilura.app",
  "build": {
    "beforeDevCommand": "bun run frontend:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Veilura",
        "width": 600,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "title": "Veilura Settings",
        "url": "index.html#/settings",
        "width": 760,
        "height": 520,
        "minWidth": 760,
        "minHeight": 280,
        "maxWidth": 760,
        "maxHeight": 700,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": false,
        "dragDropEnabled": false
      },
      {
        "label": "update",
        "title": "What's New",
        "url": "index.html#/update",
        "width": 600,
        "height": 680,
        "minWidth": 600,
        "minHeight": 480,
        "maxWidth": 600,
        "maxHeight": 760,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: asset: https://asset.localhost;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/images/**"
        ]
      },
      "capabilities": [
        "default"
      ]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "homepage": "https://veilura.online/",
    "externalBin": [
      "binaries/llama-server"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "13.4",
      "frameworks": [
        "binaries/libggml-base.0.dylib",
        "binaries/libggml-blas.0.dylib",
        "binaries/libggml-cpu.0.dylib",
        "binaries/libggml-metal.0.dylib",
        "binaries/libggml-rpc.0.dylib",
        "binaries/libggml.0.dylib",
        "binaries/libllama-common.0.dylib",
        "binaries/libllama-server-impl.dylib",
        "binaries/libllama.0.dylib",
        "binaries/libmtmd.0.dylib"
      ]
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://veilura.online/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwQjZFQTM0M0I3Q0E1QzEKUldUQnBYdzdOT3EyVUdxMEFQTEhVdjFWbEZZbi84LzJZMVZheXB2WUs3eTBEMUhsdUR5SUVXVy8K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
